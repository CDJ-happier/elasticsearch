# JVM configuration for es-debug-node1
-Xms1g
-Xmx1g

# Memory dump settings
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/data1/elk/elasticsearch/dev-utils/logs/es-debug/es-debug-node1

# GC logging
-Xlog:gc*,gc+age=trace,safepoint:file=/data1/elk/elasticsearch/dev-utils/logs/es-debug/es-debug-node1/gc.log:utctime,pid,tags:filecount=32,filesize=64m
# for debugging
-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005
