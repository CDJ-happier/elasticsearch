# JVM configuration for es-node2
-Xms4g
-Xmx4g

# Memory dump settings
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/data1/elk/elasticsearch/dev-utils/logs/es/es-node2

# GC logging
-Xlog:gc*,gc+age=trace,safepoint:file=/data1/elk/elasticsearch/dev-utils/logs/es/es-node2/gc.log:time,pid,tags:filecount=32,filesize=64m
# for debugging
-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5006
